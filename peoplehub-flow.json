{
  "version": "7.3",
  "screens": [
    {
      "id": "HOME",
      "title": "SMOD PeopleHub",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "hr_main_menu",
            "list-items": [
              {
                "id": "main_leave",
                "main-content": {
                  "title": "🏖️ İzin Süreçleri",
                  "metadata": "İzin talepleri ve kayıtlar"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "LEAVE"
                  }
                }
              },
              {
                "id": "main_0",
                "main-content": {
                  "title": "💰 Bordro ve Ücret"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "OTHER_INFO"
                  },
                  "payload": {
                    "category": "💰 Bordro ve Ücret"
                  }
                }
              },
              {
                "id": "main_1",
                "main-content": {
                  "title": "🕒 Mesai ve Devam"
                },
                "on-click-action": {
                  "name": "navigate",
